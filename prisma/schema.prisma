// Prisma Schema for Local Budget
// A personal + small-business finance system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  entities          Entity[]
  financialAccounts FinancialAccount[]
  sourceEvents      SourceEvent[]
  chartAccounts     ChartAccount[]
  accountingPeriods AccountingPeriod[]
  journalEntries    JournalEntry[]
  closedPeriods     AccountingPeriod[]         @relation("AccountingPeriodClosedBy")
  preparedCloseRuns CloseRun[]                 @relation("CloseRunPreparedBy")
  reviewedCloseRuns CloseRun[]                 @relation("CloseRunReviewedBy")
  categories        Category[]
  rules             ClassificationRule[]
  receipts          Receipt[]
  squareConnections SquareConnection[]
  squareCustomers   SquareCustomer[]
  plaidItems        PlaidItem[]
  categoryFeedback  CategoryFeedback[]
  auditEvents       FinancialAuditEvent[]      @relation("AuditTenant")
  auditActions      FinancialAuditEvent[]      @relation("AuditActor")
  reconciliations   ReconciliationAllocation[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// ENTITIES (People, Businesses, Projects)
// ============================================================================

enum EntityType {
  PERSON
  BUSINESS
  PROJECT
}

model Entity {
  id          String     @id @default(cuid())
  userId      String
  type        EntityType
  name        String
  description String?
  isDefault   Boolean    @default(false)
  metadata    Json? // Flexible storage for entity-specific data
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccounts      FinancialAccount[]
  accountOwnerships      FinancialAccountOwner[]
  transactionsAsPayer    Transaction[]           @relation("TransactionPayer")
  transactionsAsIncurred Transaction[]           @relation("TransactionIncurred")
  journalLines           JournalLine[]           @relation("JournalLineLegalOwner")

  @@index([userId])
  @@map("entities")
}

// ============================================================================
// FINANCIAL ACCOUNTS (Bank, Credit, Cash)
// ============================================================================

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
  OTHER
}

// Custody is where funds are physically held; it is intentionally separate
// from the legal/economic owner (Entity).
enum CustodyRole {
  BUSINESS
  PERSONAL
  PROCESSOR
  SHARED
  UNKNOWN
}

enum AccountOwnershipRole {
  SOLE_OWNER
  JOINT_OWNER
  CUSTODIAN
  AUTHORIZED_SIGNER
}

model FinancialAccount {
  id                 String      @id @default(cuid())
  userId             String
  entityId           String? // Optional: which entity owns this account
  custodyRole        CustodyRole @default(UNKNOWN)
  name               String
  type               AccountType
  institution        String?
  accountNumber      String? // Last 4 digits only for display
  currentBalance     Decimal     @default(0) @db.Decimal(19, 4)
  availableBalance   Decimal?    @db.Decimal(19, 4)
  currency           String      @default("USD")
  isActive           Boolean     @default(true)
  openingBalance     Decimal?    @db.Decimal(19, 4)
  openingBalanceDate DateTime?

  // Part of the owner's internal money pool (own/spouse/business accounts +
  // Venmo). Transfers BETWEEN internal accounts are reconciled and cancelled
  // out; transfers crossing the internal boundary (or unmatched ones) are
  // surfaced as exceptions (owner draws, investor funds, true income).
  isInternal Boolean @default(true)

  // Plaid integration
  plaidAccountId String?   @unique
  plaidItemId    String?
  lastSyncedAt   DateTime?

  // Square integration
  squareConnectionId String?

  // Generic metadata for external providers
  providerData Json? // Stores provider-specific data (tokens, IDs, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity            Entity?                  @relation(fields: [entityId], references: [id])
  accountOwnerships FinancialAccountOwner[]
  transactions      Transaction[]
  plaidItem         PlaidItem?               @relation(fields: [plaidItemId], references: [itemId])
  squareConnection  SquareConnection?        @relation(fields: [squareConnectionId], references: [id])
  plaidAccount      PlaidAccount?
  balanceSnapshots  AccountBalanceSnapshot[]
  settlements       ProcessorSettlement[]
  auditEvents       FinancialAuditEvent[]
  journalLines      JournalLine[]

  @@index([userId])
  @@index([plaidItemId])
  @@index([squareConnectionId])
  @@index([userId, custodyRole])
  @@map("financial_accounts")
}

// Legal custody may be joint even though every journal line has one economic
// owner. Keep account ownership many-to-many and effective-dated so household
// custody never collapses Weston and Catherine into one generic person.
model FinancialAccountOwner {
  id            String               @id @default(cuid())
  accountId     String
  entityId      String
  role          AccountOwnershipRole
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  sourceRef     String?
  confirmedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entity  Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@unique([accountId, entityId, role])
  @@index([entityId, role])
  @@map("financial_account_owners")
}

model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  itemId          String    @unique
  accessToken     String // Encrypted
  institutionId   String?
  institutionName String?
  status          String    @default("active")
  errorCode       String?
  lastSyncedAt    DateTime?
  cursor          String? // For incremental sync
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts      FinancialAccount[]
  plaidAccounts PlaidAccount[]

  @@index([userId])
  @@map("plaid_items")
}

model PlaidAccount {
  id                 String   @id @default(cuid())
  plaidItemId        String
  accountId          String   @unique // Plaid's account_id
  name               String
  mask               String?
  type               String
  subtype            String?
  financialAccountId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  plaidItem        PlaidItem         @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])

  @@index([plaidItemId])
  @@map("plaid_accounts")
}

model SquareConnection {
  id           String    @id @default(cuid())
  userId       String
  merchantId   String?
  accessToken  String // Should be encrypted in production
  refreshToken String?
  expiresAt    DateTime?
  locationIds  String[]  @default([])
  status       String    @default("active")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  FinancialAccount[]
  customers SquareCustomer[]

  @@unique([userId, merchantId])
  @@index([userId])
  @@map("square_connections")
}

// Provider-neutral immutable ingress envelope. Processing fields may advance,
// but source identity and evidence fields are append-only (see migration
// trigger). Corrections are represented by a new event or journal reversal.
enum SourceEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model SourceEvent {
  id              String            @id @default(cuid())
  userId          String
  sourceSystem    String
  sourceNamespace String
  externalId      String
  eventType       String
  eventVersion    String            @default("1")
  occurredAt      DateTime?
  settledAt       DateTime?
  receivedAt      DateTime          @default(now())
  payloadHash     String
  payload         Json?
  payloadUri      String?
  signatureStatus String?
  parserVersion   String?
  status          SourceEventStatus @default(RECEIVED)
  processingError String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  // externalId is idempotent only within this tenant/provider/account scope.
  @@unique([userId, sourceSystem, sourceNamespace, externalId])
  @@index([userId, sourceSystem, sourceNamespace])
  @@index([status, receivedAt])
  @@map("source_events")
}

enum ChartAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  CONTRA_REVENUE
  EXPENSE
  CONTRA_ASSET
}

enum AccountingPeriodStatus {
  OPEN
  REVIEW
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CloseRunStatus {
  DRAFT
  BLOCKED
  READY
  CLOSED
}

model ChartAccount {
  id        String           @id @default(cuid())
  userId    String
  code      String
  name      String
  type      ChartAccountType
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines JournalLine[]

  @@unique([userId, code])
  @@index([userId, type])
  @@map("chart_accounts")
}

model AccountingPeriod {
  id         String                 @id @default(cuid())
  userId     String
  name       String
  startsAt   DateTime
  endsAt     DateTime
  status     AccountingPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  closedBy  User?          @relation("AccountingPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  entries   JournalEntry[]
  closeRuns CloseRun[]

  @@unique([userId, startsAt, endsAt])
  @@index([userId, status, startsAt, endsAt])
  @@map("accounting_periods")
}

model CloseRun {
  id           String         @id @default(cuid())
  periodId     String
  status       CloseRunStatus @default(DRAFT)
  preparedById String
  reviewedById String?
  metrics      Json
  blockers     Json
  snapshotHash String
  reviewedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  period     AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  preparedBy User             @relation("CloseRunPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  reviewedBy User?            @relation("CloseRunReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([periodId, status, createdAt])
  @@index([preparedById])
  @@map("close_runs")
}

model JournalEntry {
  id            String             @id @default(cuid())
  userId        String
  periodId      String
  status        JournalEntryStatus @default(DRAFT)
  entryDate     DateTime
  description   String
  sourceEventId String?
  reversalOfId  String?
  postedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  sourceEvent SourceEvent?     @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  reversalOf  JournalEntry?    @relation("JournalReversals", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   JournalEntry[]   @relation("JournalReversals")
  lines       JournalLine[]

  @@unique([reversalOfId])
  @@index([userId, entryDate])
  @@index([periodId, status])
  @@index([sourceEventId])
  @@map("journal_entries")
}

model JournalLine {
  id               String   @id @default(cuid())
  journalEntryId   String
  chartAccountId   String
  description      String?
  debitAmount      Decimal  @default(0) @db.Decimal(19, 4)
  creditAmount     Decimal  @default(0) @db.Decimal(19, 4)
  legalOwnerId     String?
  custodyAccountId String?
  taxCode          String?
  createdAt        DateTime @default(now())

  journalEntry   JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  chartAccount   ChartAccount      @relation(fields: [chartAccountId], references: [id], onDelete: Restrict)
  legalOwner     Entity?           @relation("JournalLineLegalOwner", fields: [legalOwnerId], references: [id], onDelete: Restrict)
  custodyAccount FinancialAccount? @relation(fields: [custodyAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([chartAccountId])
  @@index([legalOwnerId, custodyAccountId])
  @@map("journal_lines")
}

// Resolved Square customer directory entries. Square payments only carry an
// opaque customer_id; we resolve it once via the Customers API and store the
// human-meaningful fields so revenue can be grouped/reported by customer.
model SquareCustomer {
  id                 String    @id @default(cuid())
  userId             String
  squareConnectionId String
  squareCustomerId   String // Square's customer id
  name               String?
  email              String?
  phone              String?
  companyName        String?
  firstSeen          DateTime?
  lastSeen           DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   SquareConnection @relation(fields: [squareConnectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([squareConnectionId, squareCustomerId])
  @@index([userId])
  @@index([email])
  @@map("square_customers")
}

// ============================================================================
// TRANSACTIONS
// ============================================================================

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  POSTED
  CANCELLED
  REMOVED
  REVERSED
  SUPERSEDED
}

enum ReconciliationStatus {
  UNMATCHED
  PARTIAL
  MATCHED
  EXCLUDED
}

enum ReconciliationMethod {
  AUTO
  MANUAL
  IMPORTED
}

enum ClassificationType {
  COGS // Cost of Goods Sold
  OPERATING // Operating expenses
  PERSONAL // Personal spending
  INCOME // Revenue
  TRANSFER // Internal transfers
  REIMBURSABLE // To be reimbursed
  REIMBURSEMENT // Reimbursement payment
}

model Transaction {
  id        String            @id @default(cuid())
  accountId String
  amount    Decimal           @db.Decimal(19, 4)
  type      TransactionType
  status    TransactionStatus @default(POSTED)

  // Core fields
  date         DateTime
  description  String
  merchantName String?

  // Classification
  categoryId     String?
  classification ClassificationType?

  // Entity tracking (who paid vs who incurred)
  payerId      String? // Entity that paid
  incurredById String? // Entity that incurred the expense

  // External references
  externalId  String? // Bank/Plaid transaction ID
  checkNumber String?

  // Square customer (resolved from payment.customer_id)
  squareCustomerId String?

  // Resolved canonical vendor (stable id for the brain's vendor graph)
  vendorId String?

  // User modifications and lifecycle
  userDescription      String?
  notes                String?
  isReviewed           Boolean               @default(false)
  reconciliationStatus ReconciliationStatus  @default(UNMATCHED)
  reconciliationMethod ReconciliationMethod?
  reconciledAt         DateTime?
  removedAt            DateTime?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category?        @relation(fields: [categoryId], references: [id])
  payer          Entity?          @relation("TransactionPayer", fields: [payerId], references: [id])
  incurredBy     Entity?          @relation("TransactionIncurred", fields: [incurredById], references: [id])
  squareCustomer SquareCustomer?  @relation(fields: [squareCustomerId], references: [id])
  vendor         Vendor?          @relation(fields: [vendorId], references: [id])

  lineItems        LineItem[]
  receiptLinks     ReceiptTransaction[]
  linkedFrom       TransactionLink[]           @relation("LinkedFrom")
  linkedTo         TransactionLink[]           @relation("LinkedTo")
  splits           TransactionSplit[]
  sourceIdentities TransactionSourceIdentity[]
  allocations      ReconciliationAllocation[]
  auditEvents      FinancialAuditEvent[]
  settlement       ProcessorSettlement?

  @@unique([accountId, externalId])
  @@index([accountId])
  @@index([date])
  @@index([categoryId])
  @@index([classification])
  @@index([squareCustomerId])
  @@index([vendorId])
  @@map("transactions")
}

// For splitting transactions across categories/entities
model TransactionSplit {
  id             String              @id @default(cuid())
  transactionId  String
  amount         Decimal             @db.Decimal(19, 4)
  categoryId     String?
  classification ClassificationType?
  incurredById   String?
  description    String?
  createdAt      DateTime            @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id])

  @@index([transactionId])
  @@map("transaction_splits")
}

// Links between related transactions (e.g., payment ↔ reimbursement)
model TransactionLink {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  linkType  String // "reimbursement", "transfer", "refund", etc.
  amount    Decimal? @db.Decimal(19, 4) // For partial links
  notes     String?
  createdAt DateTime @default(now())

  fromTransaction Transaction @relation("LinkedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toTransaction   Transaction @relation("LinkedTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, linkType])
  @@index([fromId])
  @@index([toId])
  @@map("transaction_links")
}

// Every provider identity ever associated with an internal cash posting.
// A pending Plaid id and its posted replacement can therefore resolve to the
// same Transaction without changing the internal id.
model TransactionSourceIdentity {
  id              String    @id @default(cuid())
  transactionId   String
  sourceSystem    String
  externalId      String
  sourceAccountId String?
  isCurrent       Boolean   @default(true)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  removedAt       DateTime?
  metadata        Json?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, sourceAccountId, externalId])
  @@index([transactionId])
  @@index([sourceSystem, sourceAccountId])
  @@map("transaction_source_identities")
}

// Accepted explanations of a cash posting. Externally owned Finance Core
// objects are logical references, never cross-database foreign keys.
model ReconciliationAllocation {
  id                 String               @id @default(cuid())
  transactionId      String
  userId             String
  settlementId       String?
  settlementEntryId  String?
  externalSystem     String
  externalObjectType String
  externalObjectId   String
  role               String
  amount             Decimal              @db.Decimal(19, 4)
  currency           String               @default("USD")
  method             ReconciliationMethod
  confidence         Decimal?             @db.Decimal(5, 4)
  acceptedAt         DateTime             @default(now())
  isCurrent          Boolean              @default(true)
  removedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  transaction     Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  settlement      ProcessorSettlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  settlementEntry ProcessorSettlementEntry? @relation(fields: [settlementEntryId], references: [id], onDelete: SetNull)

  @@unique([transactionId, externalSystem, externalObjectType, externalObjectId, role])
  @@index([userId])
  @@index([settlementId])
  @@index([settlementEntryId])
  @@map("reconciliation_allocations")
}

model ProcessorSettlement {
  id                   String               @id @default(cuid())
  accountId            String
  transactionId        String?              @unique
  provider             String
  externalId           String
  status               String
  amount               Decimal              @db.Decimal(19, 4)
  currency             String               @default("USD")
  effectiveAt          DateTime
  arrivalDate          DateTime?
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  reconciledAt         DateTime?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  account     FinancialAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction Transaction?               @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  entries     ProcessorSettlementEntry[]
  allocations ReconciliationAllocation[]

  @@unique([accountId, provider, externalId])
  @@index([provider, externalId])
  @@index([effectiveAt])
  @@map("processor_settlements")
}

model ProcessorSettlementEntry {
  id                String    @id @default(cuid())
  settlementId      String
  providerEntryId   String
  type              String
  effectiveAt       DateTime?
  grossAmount       Decimal   @db.Decimal(19, 4)
  feeAmount         Decimal   @db.Decimal(19, 4)
  netAmount         Decimal   @db.Decimal(19, 4)
  currency          String    @default("USD")
  paymentExternalId String?
  refundExternalId  String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  isCurrent         Boolean   @default(true)
  removedAt         DateTime?
  updatedAt         DateTime  @updatedAt

  settlement  ProcessorSettlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  allocations ReconciliationAllocation[]

  @@unique([settlementId, providerEntryId])
  @@index([paymentExternalId])
  @@index([refundExternalId])
  @@map("processor_settlement_entries")
}

model AccountBalanceSnapshot {
  id                 String   @id @default(cuid())
  accountId          String
  balance            Decimal  @db.Decimal(19, 4)
  availableBalance   Decimal? @db.Decimal(19, 4)
  currency           String   @default("USD")
  effectiveAt        DateTime
  source             String
  externalSnapshotId String?
  createdAt          DateTime @default(now())

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, source, effectiveAt])
  @@index([accountId, effectiveAt])
  @@map("account_balance_snapshots")
}

model FinancialAuditEvent {
  id                 String   @id @default(cuid())
  userId             String
  actorUserId        String?
  transactionId      String?
  financialAccountId String?
  action             String
  source             String
  reason             String?
  changedFields      String[]
  before             Json?
  after              Json?
  createdAt          DateTime @default(now())

  user             User              @relation("AuditTenant", fields: [userId], references: [id], onDelete: Cascade)
  actor            User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  transaction      Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([transactionId])
  @@index([financialAccountId])
  @@map("financial_audit_events")
}

// ============================================================================
// CATEGORIES
// ============================================================================

model Category {
  id                    String              @id @default(cuid())
  userId                String
  name                  String
  icon                  String?
  color                 String?
  parentId              String?
  defaultClassification ClassificationType?
  isSystem              Boolean             @default(false)
  sortOrder             Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]           @relation("CategoryHierarchy")
  transactions Transaction[]
  splits       TransactionSplit[]
  rules        ClassificationRule[]
  feedback     CategoryFeedback[]

  @@unique([userId, name, parentId])
  @@index([userId])
  @@map("categories")
}

// Categorization feedback: every time a user accepts a suggestion or overrides
// it with a different category, we record the (merchant, description, type) ->
// category outcome. The categorizer reads these as a learned, high-weight
// signal so the same merchant is suggested correctly next time — turning the
// static similarity matcher into one that improves from corrections.
model CategoryFeedback {
  id              String   @id @default(cuid())
  userId          String
  merchantKey     String // normalized merchant key ('' if none)
  descriptionKey  String // normalized description key
  type            String // INCOME | EXPENSE | TRANSFER
  categoryId      String
  // True when the user picked a category different from the top suggestion
  // (a correction) — a stronger signal than a plain acceptance.
  wasCorrection   Boolean  @default(false)
  // Running count of times this (key -> category) outcome was observed.
  timesConfirmed  Int      @default(1)
  lastConfirmedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey, descriptionKey, type, categoryId])
  @@index([userId, merchantKey])
  @@map("category_feedback")
}

// ============================================================================
// VENDORS & ITEMS (Normalized)
// ============================================================================

model Vendor {
  id                    String              @id @default(cuid())
  name                  String              @unique
  normalizedName        String // Lowercase, trimmed canonical key
  aliases               String[] // Other raw names this vendor appears as
  defaultCategoryId     String?
  defaultClassification ClassificationType? // Learned dominant classification
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  lineItems    LineItem[]
  transactions Transaction[]

  @@index([normalizedName])
  @@map("vendors")
}

model Item {
  id                String   @id @default(cuid())
  name              String
  normalizedName    String
  defaultCategoryId String?
  unitOfMeasure     String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  lineItems LineItem[]

  @@index([normalizedName])
  @@map("items")
}

// ============================================================================
// LINE ITEMS (Receipt-level detail)
// ============================================================================

// What a line represents. Lets the same table hold revenue items, fees, tax,
// discounts, etc. — shared by Square order ingest and the Margin Edge invoice
// tooling.
enum LineItemType {
  ITEM
  SHIPPING
  FEE
  TAX
  TIP
  DISCOUNT
  OTHER
}

model LineItem {
  id            String  @id @default(cuid())
  transactionId String?
  receiptId     String?
  vendorId      String?
  itemId        String?

  description String
  quantity    Decimal? @db.Decimal(10, 4)
  unitPrice   Decimal? @db.Decimal(19, 4)
  totalPrice  Decimal  @db.Decimal(19, 4)

  lineType       LineItemType        @default(ITEM)
  categoryId     String?
  classification ClassificationType?

  // Stable id from the source system (e.g. Square order line uid) so re-syncs
  // upsert instead of duplicating.
  sourceUid String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receipt     Receipt?     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  vendor      Vendor?      @relation(fields: [vendorId], references: [id])
  item        Item?        @relation(fields: [itemId], references: [id])

  @@unique([transactionId, sourceUid])
  @@index([transactionId])
  @@index([receiptId])
  @@map("line_items")
}

// ============================================================================
// RECEIPTS & EVIDENCE
// ============================================================================

enum ReceiptStatus {
  PENDING // Just uploaded
  PROCESSING // OCR in progress
  PROCESSED // OCR complete
  FAILED // OCR failed
  REVIEWED // User has reviewed
}

model Receipt {
  id     String        @id @default(cuid())
  userId String
  status ReceiptStatus @default(PENDING)

  // File info
  fileName    String
  fileType    String
  filePath    String
  fileSize    Int
  contentHash String?
  capturedAt  DateTime  @default(now())
  deletedAt   DateTime?

  // Extracted data
  vendorName  String?
  totalAmount Decimal?  @db.Decimal(19, 4)
  subtotal    Decimal?  @db.Decimal(19, 4)
  tax         Decimal?  @db.Decimal(19, 4)
  tip         Decimal?  @db.Decimal(19, 4)
  receiptDate DateTime?

  // OCR metadata
  rawOcrText    String? @db.Text
  ocrConfidence Float?
  extractedData Json? // Full structured extraction

  // Source tracking
  source   String? // "upload", "email", "api"
  sourceId String? // Email ID, etc.

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineItems        LineItem[]
  transactionLinks ReceiptTransaction[]

  @@unique([userId, contentHash])
  @@index([userId])
  @@index([status])
  @@index([userId, deletedAt])
  @@map("receipts")
}

// Many-to-many: Receipts ↔ Transactions
model ReceiptTransaction {
  id              String   @id @default(cuid())
  receiptId       String
  transactionId   String
  matchConfidence Float? // How confident the auto-match was
  isManual        Boolean  @default(false)
  createdAt       DateTime @default(now())

  receipt     Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([receiptId, transactionId])
  @@index([receiptId])
  @@index([transactionId])
  @@map("receipt_transactions")
}

// ============================================================================
// CLASSIFICATION RULES
// ============================================================================

enum RuleMatchType {
  EXACT
  CONTAINS
  STARTS_WITH
  REGEX
}

model ClassificationRule {
  id       String  @id @default(cuid())
  userId   String
  name     String
  isActive Boolean @default(true)
  priority Int     @default(0)

  // Match conditions
  matchField String // "merchantName", "description", "amount", etc.
  matchType  RuleMatchType
  matchValue String

  // Actions
  categoryId     String?
  classification ClassificationType?
  incurredById   String?

  // Stats
  timesApplied  Int       @default(0)
  lastAppliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([isActive])
  @@map("classification_rules")
}

// ============================================================================
// BACKGROUND JOBS
// ============================================================================

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        String // "plaid_sync", "ocr_receipt", "apply_rules", etc.
  status      JobStatus @default(PENDING)
  payload     Json?
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([scheduledAt])
  @@map("background_jobs")
}
